# ============================================================
# Environment Variables for Lumiere Cosmetics E-shop
# ============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.
# ============================================================

# Django
SECRET_KEY=your-django-secret-key-here
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Supabase PostgreSQL ----
# Go to: Supabase Dashboard → Project Settings → Database → Connection string (URI)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DB_CONN_MAX_AGE=120
DB_CONNECT_TIMEOUT=10
DB_SERVER_OPTIONS=-c statement_timeout=15000 -c lock_timeout=5000

# Rescue mode for local start if Supabase is unavailable/locked
# Set to true to force local SQLite regardless of DATABASE_URL
FORCE_SQLITE=false

# DRF throttling (anti-overload defaults)
DRF_THROTTLE_ANON=120/minute
DRF_THROTTLE_USER=300/minute

# API cache defaults (for high-read endpoints)
CACHE_DEFAULT_TIMEOUT=300
CACHE_MIDDLEWARE_SECONDS=300

# Supabase Storage resilience
AWS_S3_CONNECT_TIMEOUT=10
AWS_S3_READ_TIMEOUT=20
AWS_S3_MAX_RETRIES=3

# Logging levels
DJANGO_REQUEST_LOG_LEVEL=INFO
DJANGO_DB_LOG_LEVEL=WARNING

# ---- Supabase Storage (S3-compatible) ----
# Go to: Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# Storage bucket name (create this bucket in Supabase → Storage, set to Public)
SUPABASE_STORAGE_BUCKET=products

# S3 endpoint is auto-derived from SUPABASE_URL, but you can override:
# SUPABASE_S3_ENDPOINT=https://[YOUR-PROJECT-REF].supabase.co/storage/v1/s3
