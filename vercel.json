{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.py" },
    { "source": "/admin/(.*)", "destination": "/api/index.py" },
    { "source": "/static/admin/(.*)", "destination": "/api/index.py" },
    { "source": "/assets/(.*)", "destination": "/frontend/assets/$1" },
    { "source": "/favicon.svg", "destination": "/frontend/favicon.svg" },
    { "source": "/vite.svg", "destination": "/frontend/vite.svg" },
    { "source": "/(.*)", "destination": "/frontend/index.html" }
  ]
}
